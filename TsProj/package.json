{
  "name": "unity-puerts-template-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript runtime code for the Unity PuerTS template.",
  "scripts": {
    "staticdata:prepare": "npm --prefix staticdata install --ignore-scripts --no-audit --no-fund && npm --prefix staticdata run build:targets:client",
    "prebuild": "npm run staticdata:prepare",
    "build": "tsc -p tsconfig.json",
    "prewatch": "npm run staticdata:prepare",
    "watch": "tsc-watch -p tsconfig.json",
    "precheck": "npm run staticdata:prepare",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3"
  }
}
